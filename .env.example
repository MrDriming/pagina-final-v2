# ── Supabase Auth ──────────────────────────────────────────────
# Project Settings > API   (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-o-anon-key

# ── Postgres (Drizzle) ─────────────────────────────────────────
# Project Settings > Database > Connect
#
# En Vercel usá SIEMPRE el "Transaction pooler". La conexión directa
# (db.<ref>.supabase.co) resuelve solo por IPv6 y las funciones de Vercel
# salen por IPv4: da ENETUNREACH. Ojo que en el pooler el usuario es
# `postgres.<project-ref>`, no `postgres`.
DATABASE_URL=postgresql://postgres.tu-proyecto:PASSWORD@aws-0-tu-region.pooler.supabase.com:6543/postgres
#
# Local, con la conexión directa, también sirve:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.tu-proyecto.supabase.co:5432/postgres

# (Recomendado en producción) Certificado de la CA de Supabase, para verificar
# el server y no solo cifrar. Se baja de Settings > Database > SSL Configuration
# y se pega entero, incluidas las líneas BEGIN/END. Sin esto la conexión va
# cifrada pero sin verificar el certificado.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Bypass de login (SOLO local) ───────────────────────────────
# true = entra directo al dashboard sin credenciales, para recorrer el
# sistema sin Supabase. Se ignora si NODE_ENV=production.
DEV_BYPASS_AUTH=false
# alumno | profesor | admin  (default: admin)
DEV_BYPASS_ROLE=admin
# (Opcional) UUID de un usuario real en perfiles para impersonar. Si no está seteado,
# el bypass devuelve un usuario falso. Permite probar scoping sin loguearse.
# DEV_BYPASS_USER_ID=

# ── Gmail (notificaciones por mail, opcional) ──────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
