# ── Supabase Auth ──────────────────────────────────────────────
# Project Settings > API   (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-o-anon-key

# ── Postgres (Drizzle) ─────────────────────────────────────────
# Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:PASSWORD@db.tu-proyecto.supabase.co:5432/postgres

# ── Bypass de login (SOLO local) ───────────────────────────────
# true = entra directo al dashboard sin credenciales, para recorrer el
# sistema sin Supabase. Se ignora si NODE_ENV=production.
DEV_BYPASS_AUTH=false
# alumno | profesor | admin  (default: admin)
DEV_BYPASS_ROLE=admin

# ── Gmail (notificaciones por mail, opcional) ──────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
